<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.uam.edu.hilosjava.concurrencia.Controlador">
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
    <children>
        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Procesamiento Concurrente en Ventanillas" />

        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Label text="Estado actual:" />
                <Label fx:id="lblEstado" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1d3557;" text="En espera" />
            </children>
        </HBox>

        <Label fx:id="lblContador" style="-fx-font-size: 13px; -fx-font-weight: bold;" text="Atenciones Totales: 0" />

        <HBox alignment="CENTER" spacing="15.0">
            <children>
                <Button fx:id="btnIniciar" onAction="#handleIniciar" style="-fx-background-color: #2a9d8f; -fx-text-fill: white; -fx-font-weight: bold;" text="Iniciar" />
                <Button fx:id="btnDetener" disable="true" onAction="#handleDetener" style="-fx-background-color: #e76f51; -fx-text-fill: white; -fx-font-weight: bold;" text="Detener" />
            </children>
        </HBox>

        <Label text="Registro de actividad:" />
        <TextArea fx:id="areaLogs" editable="false" prefHeight="260.0" />
    </children>
</VBox>